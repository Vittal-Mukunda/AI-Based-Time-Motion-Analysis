# ─────────────────────────────────────────────────────────────────────────────
# Kinetic Analytics V2.0 — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to  backend/.env  and fill in the values.
# The .env file is NOT committed to version control.
#
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# Path to the trained YOLOv8 weights file (required).
# Example (Windows):
#   MODEL_PATH=C:\Users\you\runs\detect\board_detector\weights\best.pt
# Example (Linux/Mac):
#   MODEL_PATH=/home/you/models/best.pt
MODEL_PATH=

# Video source (required).
# Use a file path for recorded video, or an integer for a live webcam.
# Examples:
#   VIDEO_PATH=C:\Users\you\Videos\WSD_Video.mp4
#   VIDEO_PATH=/home/you/videos/wsd.mp4
#   VIDEO_PATH=0          # first webcam
VIDEO_PATH=0
